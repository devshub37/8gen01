# 8Gen Configuration
# All settings use the EIGHTGEN_ prefix (legacy GEMINI_API_KEY / PROVIDER also work).

# --- Provider ----------------------------------------------------------------
# "auto" (default) picks Gemini when a key is configured, otherwise local Ollama.
# Set "gemini" or "ollama" to force a specific provider.
EIGHTGEN_PROVIDER=auto
# EIGHTGEN_GEMINI_API_KEY=your-key-here
# EIGHTGEN_GEMINI_MODEL=gemini-3-flash-preview

EIGHTGEN_OLLAMA_URL=http://localhost:11434
EIGHTGEN_MODEL=huihui_ai/qwen2.5-coder-abliterate:7b
EIGHTGEN_OUTPUT_DIR=./games
EIGHTGEN_DB_PATH=./games/8gen.db
EIGHTGEN_SERVER_HOST=127.0.0.1
EIGHTGEN_SERVER_PORT=8000
EIGHTGEN_AUTO_OPEN=true
EIGHTGEN_TEMPERATURE=0.7
EIGHTGEN_MAX_RETRIES=3

# --- Server security (recommended for any non-local deployment) --------------
# Enables a login page for the dashboard and all mutating API endpoints.
# EIGHTGEN_API_TOKEN=change-me
# Comma-separated origins allowed by CORS; empty = same-origin only.
# EIGHTGEN_CORS_ORIGINS=https://example.com
# Mutating requests allowed per client per minute (0 disables the limiter).
# EIGHTGEN_RATE_LIMIT=30

# --- Generation quality gates ------------------------------------------------
# Run node --check on generated scripts during validation (1/0).
EIGHTGEN_JS_SYNTAX_CHECK=1
# Run a headless-browser smoke test on generated games (requires playwright).
EIGHTGEN_SMOKE_TEST=0
